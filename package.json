{
  "name": "codex-quota-bridge",
  "version": "1.0.0",
  "description": "Local reasoning-offload and quota-optimization companion for Codex",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3113y/Codex-Quota-Bridge.git"
  },
  "homepage": "https://github.com/3113y/Codex-Quota-Bridge#readme",
  "bugs": {
    "url": "https://github.com/3113y/Codex-Quota-Bridge/issues"
  },
  "files": [
    ".codex-plugin",
    ".mcp.json",
    "dist",
    "docs",
    "hooks",
    "skills",
    "prompts",
    "config.example.yaml",
    "config.assisted.example.yaml",
    "config.autopilot.example.yaml",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "cqb": "dist/cli/index.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "demo": "node scripts/demo.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "package:plugin": "node scripts/package-plugin.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
